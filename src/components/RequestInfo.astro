---
import { ArrowRight, ArrowDown } from 'lucide-astro'
---

<div class="flex flex-col gap-16">
    <div class="flex items-center gap-2 text-white py-2 px-4 rounded-lg bg-emerald-900 w-fit hover:opacity-90 transition-colors">
        <a 
            href="#contact" 
            class="font-sans font-semibold"
        >
            Solicitar información
        </a>
        <ArrowRight class="ml-2 h-4 w-4" />
    </div>
    <p class="text-amber-800/50 text-sm sm:text-base">
        ✦ Precios con IVA incluido · Entrega en toda España
    </p>
</div>
