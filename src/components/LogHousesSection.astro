---
import OnScrollReveal from 'astro-onscroll-animations';
import { Image } from 'astro:assets';
import { ArrowRight } from 'lucide-astro';

import log_house from '@/assets/log_houses/log_house.jpg';
import log_house2 from '@/assets/log_houses/log_house2.jpg';
import log_house3 from '@/assets/log_houses/log_house3.jpg';
import log_house4 from '@/assets/log_houses/log_house4.jpg';
import log_house5 from '@/assets/log_houses/log_house5.png';
import log_house6 from '@/assets/log_houses/log_house6.jpg';
import RequestInfo from './RequestInfo.astro';

const log_houses = [
    {
        id: '1',
        name: 'Primera casa de madera',
        image: log_house
    },
    {
        id: '2',
        name: 'Segunda casa de madera',
        image: log_house2
    },
    {
        id: '3',
        name: 'Tercera casa de madera',
        image: log_house3
    },
    {
        id: '4',
        name: 'Cuarta casa de madera',
        image: log_house4
    },
    {
        id: '5',
        name: 'Quinta casa de madera',
        image: log_house5
    },
    {
        id: '5',
        name: 'Sext casa de madera',
        image: log_house6
    }
]
---

<section id="log-houses" class="py-20 sm:py-24 lg:py-32 px-4 sm:px-6 lg:px-8 scroll-animation scroll-animation-default">
    <div class="max-w-6xl mx-auto">
        <!-- ── Header ───────────────────────────────────────────── -->
        <div class="max-w-7xl mb-12 sm:mb-16 lg:mb-20">
            <h2 class="section-title reveal delay-1 font-serif text-3xl sm:text-4xl md:text-5xl lg:text-6xl mb-4 sm:mb-6">
                <!-- FIX 1: <p> is not valid inside <h2>; changed to <span class="block"> -->
                <span class="block text-xs font-medium font-sans tracking-widest uppercase text-stone-400 mb-3 sm:mb-4">
                    Construidas por la naturaleza
                </span>
                Casas hechas de <span class="text-amber-800">troncos de madera</span>
            </h2>
            <p class="text-stone-600 max-w-lg text-sm sm:text-base">
                <span>✦</span>
                Cada uno de nuestros modelos de casas de troncos está prediseñado para un montaje rápido sin sacrificar 
                ni un centímetro de calidez o carácter.
            </p>
        </div>

        <!-- ── Separator ───────────────────────────────────────────── -->
        <div class="w-full h-px bg-stone-200 mb-10 sm:mb-12 lg:mb-14"></div>

        <div id="info-log-houses" class="mx-auto max-w-6xl mb-16 sm:mb-24 lg:mb-32 scroll-mt-32 scroll-animation scroll-animation-default">
            <h1 class="text-xl sm:text-2xl font-serif font-light text-gray-800 border-l-2 border-[#b8895a] pl-4 sm:pl-6 self-start mb-8 sm:mb-12">
                ¿Qué son las casas de troncos de madera?
            </h1>
            <p class="text-base sm:text-lg leading-relaxed mb-8 sm:mb-12">
                Son construcciones que combinan técnicas artesanales centenarias con materiales naturales de gran durabilidad. 
                Elaboradas principalmente con troncos macizos ensamblados, destacan por su excelente aislamiento térmico, resistencia y estética rústica. Estas viviendas reflejan la herencia arquitectónica búlgara, ofreciendo espacios acogedores, sostenibles y 
                perfectamente integrados en entornos montañosos o naturales. Hoy en día, siguen siendo valoradas tanto por su encanto tradicional como por su eficiencia ecológica.
            </p>
        </div>
    
        <!-- ── Cards grid ─────────────────────────────────────────── -->
        <div class="overflow-x-auto pb-8 -mx-4 px-4 snap-x snap-mandatory mb-16">
            <div class="flex gap-4 w-max">
                {log_houses.map((h, i) => (
                    <article class="snap-center w-md shrink-0 rounded-lg overflow-hidden bg-white shadow-lg">
                        <div class="h-48 overflow-hidden">
                            <Image 
                                src={h.image} 
                                alt={h.name} 
                                class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" />
                        </div>
                    </article>
                ))}
            </div>
        </div>
        <RequestInfo />
    </div>

    <OnScrollReveal />
</section>

