---
import { Image } from 'astro:assets';
import { ArrowRight } from 'lucide-astro';
import OnScrollReveal from 'astro-onscroll-animations';

import log_house from '@/assets/log_houses/log_house.jpg'
import log_house2 from '@/assets/log_houses/log_house2.jpg'
import log_house3 from '@/assets/log_houses/log_house3.jpg'
import log_house4 from '@/assets/log_houses/log_house4.jpg'

const log_houses = [
    {
        id: '1',
        name: 'Primera casa de madera',
        image: log_house,
        price: '9.800€',
    },
    {
        id: '2',
        name: 'Segunda casa de madera',
        image: log_house2,
        price: '6.500€',
    },
    {
        id: '3',
        name: 'Tercera casa de madera',
        image: log_house3,
        price: '7.800€',
    },
    {
        id: '4',
        name: 'Cuarta casa de madera',
        image: log_house4,
        price: '6.900€',
    }
]
---

<section id="log-houses" class="py-28 px-6 scroll-animation scroll-animation-default">
    <div class="max-w-6xl mx-auto">
        <!-- ── Header ───────────────────────────────────────────── -->
        <div class="max-w-7xl mb-20">
            <h2 class="section-title reveal delay-1 font-serif text-5xl md:text-6xl mb-6">
                <!-- FIX 1: <p> is not valid inside <h2>; changed to <span class="block"> -->
                <span class="block text-xs font-medium font-sans tracking-widest uppercase text-stone-400 mb-4">
                    Construidas por la naturaleza
                </span>
                Casas hechas de <span class="text-amber-800">troncos de madera</span>
            </h2>
            <p class="text-gray-500 max-w-lg">
                <span>✦</span>
                Cada uno de nuestros modelos de casas de troncos está prediseñado para un montaje rápido sin sacrificar 
                ni un centímetro de calidez o carácter.
            </p>
        </div>
    
        <!-- ── Cards grid ─────────────────────────────────────────── -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
        {
            log_houses.map((h, i) => (
                <article
                    class={`house-card reveal delay-${i + 2}`}
                    style={`animation-delay: ${0.2 + i * 0.15}s`}
                >
                    <div class="card-accent"></div>
                    <!-- Image -->
                    <div class="relative h-52 overflow-hidden">
                        <Image
                            src={h.image}
                            alt={h.name}
                            class="card-img w-full h-full object-cover cursor-pointer transition-transform duration-800 hover:scale-110"
                            loading="lazy"
                        />
                    </div>
                </article>
            ))
        }
        </div>
        <!-- ── Footer ───────────────────────────────────────────── -->
        <div class="flex flex-col gap-12 mb-8">
            <h3 class=" text-xl font-bold">Pendiente precio</h3>
            <p class="text-amber-800/50">
                ✦ Precios con IVA incluido · Entrega en toda España
            </p>
            <a href="#contact" class="flex items-center w-fit border border-gray-300 px-4 py-2 rounded-lg hover:bg-emerald-800 hover:text-white transition-colors">
                Solicitar información
                <ArrowRight className="ml-2 h-4 w-4" />
            </a>
        </div>
    </div>

    <OnScrollReveal />
</section>

