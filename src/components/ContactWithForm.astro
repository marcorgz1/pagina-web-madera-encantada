---
import { Mail, MapPin, Phone, Send } from '@lucide/astro'
import OnScrollReveal from 'astro-onscroll-animations'
---

<section
    id="contact"
    class="scroll-mt-48 scroll-animation scroll-animation-default"
>
    <div class="flex justify-center items-center mb-48">
        <div class="flex flex-col w-full px-64">
            <div class="flex flex-col gap-6 mb-16">
                <h3
                    class="text-emerald-700 text-sm font-semibold tracking-[0.2em] uppercase"
                >
                    Contáctanos
                </h3>
                <h1 class="text-6xl text-gray-800/80 font-serif font-semibold">
                    Vamos a planificar tu nueva casa
                    <br />
                </h1>
                <span class="text-xl text-amber-800/40">
                    ¿Tienes alguna duda? Nuestro equipo estará encantado de
                    ayudarte a escoger tu casa perfecta.
                </span>
            </div>
            <div class="flex justify-between items-center gap-72 mb-24">
                <div class="flex justify-center items-center gap-2 mb-24">
                    <ul class="flex flex-col justify-center items-center gap-16 w-full">
                        <li
                            class="flex items-center w-sm px-8 py-6 border border-gray-200 shadow-sm rounded-2xl gap-8 hover:shadow-md"
                        >
                            <div
                                class="w-12 h-12 bg-emerald-50 rounded-lg flex items-center justify-center flex-shrink-0"
                            >
                                <Mail class="w-6 h-6 text-emerald-800" />
                            </div>
                            <div class="flex flex-col gap-2">
                                <p class="text-gray-400 uppercase text-sm">
                                    Escríbenos
                                </p>
                                <a href="mailto:contact@madera-encantada.es"
                                    >contact@madera-encantada.es</a
                                >
                            </div>
                        </li>
                        <li
                            class="flex items-center gap-8 w-sm px-8 py-6 border border-gray-200 shadow-sm rounded-2xl hover:shadow-md"
                        >
                            <div
                                class="w-12 h-12 bg-emerald-50 rounded-lg flex items-center justify-center flex-shrink-0"
                            >
                                <Phone class="w-6 h-6 text-emerald-800" />
                            </div>
                            <div class="flex flex-col gap-2">
                                <p class="text-gray-400 uppercase">Llámanos</p>
                                <div class="flex flex-col gap-2">
                                    <a
                                        href="tel:+34652447192"
                                        class="hover:text-emerald-600 transition-colors"
                                    >
                                        +34 652 447 192
                                    </a>
                                    <a
                                        href="tel:+34613336085"
                                        class="hover:text-emerald-600 transition-colors"
                                    >
                                        +34 613 336 085
                                    </a>
                                </div>
                            </div>
                        </li>
                        <li
                            class="flex items-center px-8 py-6 border border-gray-200 shadow-sm w-sm rounded-2xl gap-8 hover:shadow-md"
                        >
                            <div
                                class="w-12 h-12 bg-emerald-50 rounded-lg flex items-center justify-center flex-shrink-0"
                            >
                                <MapPin class="w-6 h-6 text-emerald-800" />
                            </div>
                            <div class="flex flex-col gap-2">
                                <p class="text-gray-400 uppercase">Dirección</p>
                                <p class="flex flex-col gap-12">
                                    Tudela -Navarra
                                    <br />
                                    Polígono Las Labradas 1
                                    <br />
                                    Calle Estella nave C1
                                </p>
                            </div>
                        </li>
                    </ul>
                </div>
                <div class="w-full">
                    <form class="space-y-6" method="POST" action="/api/contact">
                        <div>
                            <label
                                for="name"
                                class="block text-sm font-medium text-gray-700 mb-2"
                            >
                                Nombre completo <span class="text-red-800">*</span>
                            </label>
                            <input
                                type="text"
                                id="name"
                                name="name"
                                required
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-700 focus:border-transparent outline-none transition-all"
                                placeholder="Tu nombre"
                            />
                        </div>
    
                        <div>
                            <label
                                for="email"
                                class="block text-sm font-medium text-gray-700 mb-2"
                            >
                                Correo electrónico <span class="text-red-800">*</span>
                            </label>
                            <input
                                type="email"
                                id="email"
                                name="email"
                                required
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-700 focus:border-transparent outline-none transition-all"
                                placeholder="Tu correo electrónico"
                            />
                        </div>
    
                        <div>
                            <label
                                for="phone"
                                class="block text-sm font-medium text-gray-700 mb-2"
                            >
                                Número de teléfono <span class="text-red-800">*</span>
                            </label>
                            <input
                                type="tel"
                                id="phone"
                                name="phone"
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-700 focus:border-transparent outline-none transition-all"
                                placeholder="Tu número de teléfono"
                            />
                        </div>
    
                        <div>
                            <label
                                for="message"
                                class="block text-sm font-medium text-gray-700 mb-2"
                            >
                                Mensaje <span class="text-red-800">*</span>
                            </label>
                            <textarea
                                id="message"
                                name="message"
                                required
                                rows={5}
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-700 focus:border-transparent outline-none transition-all resize-none"
                                placeholder="Cuéntanos lo que necesites saber..."
                            ></textarea>
                        </div>
    
                        <button
                            type="submit"
                            class="w-full bg-emerald-600 text-white py-3 rounded-lg font-semibold hover:bg-emerald-700 transition-all transform hover:scale-105 shadow-lg inline-flex items-center justify-center space-x-2"
                        >
                            <Send class="h-5 w-5" />
                            <span>Enviar</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<OnScrollReveal />
