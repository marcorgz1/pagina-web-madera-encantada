---
import OnScrollReveal from 'astro-onscroll-animations';
import { Award, CheckCircle, Users, Zap } from 'lucide-astro';

import ConstructionProcess from "./ConstructionProcess.astro";

const features = [
    {
        icon: Award,
        title: 'Construcción de calidad',
        description: 'Cada casa está construida con los mejores materiales y una mano de obra excepcional',
    },
    {
        icon: Zap,
        title: 'Entrega rápida',
        description: 'Nada de esperas ni de retrasos. Tu casa estará lista para usar cuando tú lo desees'
    },
    {
        icon: Users,
        title: 'Equipo con experiencia Expert Team',
        description: 'Disponemos de un equipo de profesionales que se asegurarán de convertir tu sueño en realidad',
    },
    {
        icon: CheckCircle,
        title: 'Calidad y comodidad garantizadas',
        description: 'Cada una de nuestras casas ha pasado por una revisión restricta y detallada para asegurar la mayor calidad y comodidad posibles',
    }
];
---
<!-- 
max-w-md: se aplica a pantallas de -640px
sm:max-w-lg: se aplica a pantallas de +=640 -768px
md:max-w-6xl se aplica a pantallas de =+768px
-->
<section class="max-w-md sm:max-w-xl md:max-w-6xl mx-auto">
    <div id="about-us" class="mb-24 scroll-mt-32 scroll-animation scroll-animation-default delay-600">
        <div class="flex flex-col gap-3 sm:gap-4 mb-8">
            <h3 class="text-emerald-700 text-xs sm:text-sm font-semibold tracking-[0.2em] uppercase">Información</h3>
            <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-amber-800">
                Sobre nosotros
            </h1>
        </div>
        <!-- Divider -->
        <div class="w-full h-px bg-stone-200 mb-8"></div>
        <h3 class="text-lg sm:text-md leading-relaxed">
            Somos una empresa fundada con el objetivo de transformar el concepto tradicional de vivienda, nuestra empresa nace en España como respuesta a la creciente demanda de soluciones habitacionales más eficientes, sostenibles y accesibles. Inspirados por la evolución de la construcción industrializada, apostamos por el desarrollo de casas prefabricadas que combinan diseño contemporáneo, innovación tecnológica y altos estándares de calidad.
            Desde nuestros inicios, hemos trabajado bajo un modelo de fabricación en entornos controlados, lo que permite optimizar tiempos, reducir costes y garantizar una ejecución precisa en cada proyecto. Este enfoque, cada vez más consolidado en el sector, ofrece viviendas personalizables, energéticamente eficientes y adaptadas a las necesidades actuales de nuestros clientes.
            A lo largo de los años, hemos evolucionado junto al mercado, incorporando nuevas técnicas constructivas y materiales sostenibles, posicionándonos como una alternativa sólida frente a la construcción tradicional. Hoy, seguimos comprometidos con la innovación y el diseño, acompañando a cada cliente en el proceso de crear un hogar único, funcional y preparado para el futuro.
        </h3>
    </div>

    <ConstructionProcess />

    <div id="why-choose-us" class="mx-auto max-w-md sm:max-w-xl md:max-w-6xl mb-24 scroll-mt-32 scroll-animation scroll-animation-default">
        <div class="flex flex-col gap-3 sm:gap-4 mb-8">
            <h3 class="text-emerald-700 text-xs sm:text-sm font-semibold tracking-[0.2em] uppercase">Sobre nosotros</h3>
            <h1 class="text-3xl sm:text-4xl md:text-5xl text-amber-800 font-medium">
                ¿Por qué elegir Madera Encantada?
            </h1>
        </div>
        <!-- Divider -->
        <div class="w-full h-px bg-stone-200 mb-8"></div>
        <p class="text-md sm:text-md leading-relaxed mb-24">
            Somos una empresa fundada con el objetivo de transformar el concepto tradicional de vivienda, nuestra empresa nace en España como respuesta a la creciente demanda de soluciones habitacionales más eficientes, sostenibles y accesibles. Inspirados por la evolución de la construcción industrializada, apostamos por el desarrollo de casas prefabricadas que combinan diseño contemporáneo, innovación tecnológica y altos estándares de calidad.
            Desde nuestros inicios, hemos trabajado bajo un modelo de fabricación en entornos controlados, lo que permite optimizar tiempos, reducir costes y garantizar una ejecución precisa en cada proyecto. Este enfoque, cada vez más consolidado en el sector, ofrece viviendas personalizables, energéticamente eficientes y adaptadas a las necesidades actuales de nuestros clientes.
            A lo largo de los años, hemos evolucionado junto al mercado, incorporando nuevas técnicas constructivas y materiales sostenibles, posicionándonos como una alternativa sólida frente a la construcción tradicional. Hoy, seguimos comprometidos con la innovación y el diseño, acompañando a cada cliente en el proceso de crear un hogar único, funcional y preparado para el futuro.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8 lg:gap-12 mx-auto max-w-lg md:max-w-full">
        {
            features.map((feature) => (
                <div class="text-center p-6 sm:p-8 lg:p-10 rounded-xl bg-linear-to-br from-emerald-50 to-teal-50 hover:shadow-lg transition-shadow">
                    <div class="inline-flex items-center justify-center w-14 h-14 sm:w-16 sm:h-16 bg-emerald-100 rounded-full mb-4 sm:mb-6">
                        <feature.icon class="h-7 w-7 sm:h-8 sm:w-8 text-emerald-600" />
                    </div>
                    <h4 class="text-lg sm:text-xl font-bold text-gray-900 mb-3 sm:mb-4">
                        {feature.title}
                    </h4>
                    <p class="text-sm sm:text-base text-gray-400 leading-relaxed">
                        {feature.description}
                    </p>
                </div>
            ))
        }    
        </div>
    </div>
    
    <OnScrollReveal />
</section>
