---
import OnScrollReveal from 'astro-onscroll-animations';
import constructionProcessVideo from '../assets/video.mp4';
---

<section
    id="proceso"
    class="relative mx-auto max-w-md sm:max-w-xl md:max-w-6xl px-4 sm:px-6 mb-24 md:mb-32 scroll-mt-24 scroll-animation scroll-animation-default"
    aria-labelledby="proceso-title"
>
    <!-- Header -->
    <header class="flex flex-col gap-3 sm:gap-4 max-w-2xl mb-8 md:mb-12">
        <p class="text-emerald-700 text-xs sm:text-sm font-semibold tracking-[0.2em] uppercase">
            Cómo lo hacemos
        </p>
        <h2
            id="proceso-title"
            class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-amber-800 text-balance"
        >
            Proceso de construcción
        </h2>
        <p class="text-stone-600 text-base sm:text-lg leading-relaxed">
            Un resumen visual de cómo pasamos del diseño a la vivienda terminada.
        </p>
    </header>

    <div class="w-full h-px bg-stone-200 mb-8 md:mb-12"></div>

    <!-- Content: video + steps -->
    <div class="grid gap-32 lg:gap-24 lg:grid-cols-[1.4fr_1fr] items-start">
        <figure class="m-0">
            <video
                class="w-full aspect-video rounded-xl bg-stone-100 object-cover shadow-lg ring-1 ring-stone-200"
                preload="metadata"
                playsinline
                muted
                controls
                loop
                aria-label="Vídeo del proceso de construcción"
            >
                <source src={constructionProcessVideo} type="video/mp4" />
                Tu navegador no admite vídeo HTML5.
            </video>
        </figure>

        <ol class="flex flex-col gap-8">
            {[
                { title: "Diseño y planificación", text: "Adaptamos el proyecto a tus necesidades." },
                { title: "Fabricación", text: "Producción controlada por expertos." },
                { title: "Montaje", text: "Instalación rápida en parcela." },
                { title: "Entrega", text: "Revisión final y entrega de llaves en mano." },
            ].map((step, i) => (
                <li class="flex gap-4">
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-emerald-700/10 text-emerald-700 font-semibold">
                        {i + 1}
                    </span>
                    <div>
                        <h3 class="font-semibold text-stone-800">{step.title}</h3>
                        <p class="text-stone-600 text-sm sm:text-base leading-relaxed">{step.text}</p>
                    </div>
                </li>
            ))}
        </ol>
    </div>

    <OnScrollReveal />
</section>
