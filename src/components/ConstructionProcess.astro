---
import OnScrollReveal from 'astro-onscroll-animations';

import processVideo from '../assets/video.mp4';
---

<section class="relative mx-auto max-w-6xl md:max-w-2xl sm:max-w-md mb-32 scroll-animation scroll-animation-default ">
    <div class="flex flex-col gap-3 sm:gap-4 max-w-xl">
        <h3
            class="text-emerald-700 text-xs sm:text-sm font-semibold tracking-[0.2em] uppercase"
        >
            Cómo lo hacemos
        </h3>
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-amber-800 mb-8 sm:mb-12 lg:mb-16">
            Proceso de construcción
        </h1>
    </div>
    <!-- Divider -->
    <div class="w-full h-px bg-stone-200 mb-8 sm:mb-12 lg:mb-14"></div>
    <video 
        class="mx-auto rounded-lg mb-12"
        muted 
        controls 
        loop
        preload="none"
        transition:persist
    >
        <source src={processVideo} type="video/mp4" />
    </video>

    <OnScrollReveal />
</section>
