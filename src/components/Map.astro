---
interface Props {
  src: string;
  title?: string;
  class?: string;
}

const { src, title = "Ubicación", class: className = "" } = Astro.props;
---

<div class={`rounded-2xl overflow-hidden border border-gray-200 shadow-sm ${className}`}>
    <iframe
        src={src}
        width="100%"
        height="100%"
        style="border:0;"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title={title}
    ></iframe>
</div>
