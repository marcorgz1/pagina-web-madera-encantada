---
import { Image } from 'astro:assets'
const { name, image, price } = Astro.props
---

<article
    class="group relative flex flex-col bg-white overflow-hidden rounded-2xl shadow-sm hover:shadow-2xl transition-all duration-500 hover:-translate-y-1.5 py-4 border border-stone-100 md:max-w-xl"
>
    <!-- Image wrapper -->
    <div class="relative overflow-hidden bg-stone-50">
        <Image
            src={image}
            alt={name}
            loading="lazy"
            class="md:max-w-[80%] max-w-full h-full mx-auto object-cover transition-transform duration-700 group-hover:scale-105"
        />
        <!-- Subtle gradient overlay at bottom of image -->
        <div
            class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"
        >
        </div>
    </div>

    <!-- Content -->
    <div class="justify-between items-center px-8 py-4">
        <div class="flex justify-between items-center px-4 py-2">
            <span
                class="text-xs uppercase tracking-widest text-stone-400 font-medium"
                >Desde</span
            >
            <span class="text-4xl font-bold text-emerald-700 leading-none"
                >{price}</span
            >
        </div>
    </div>
</article>
