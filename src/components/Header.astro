---
import brandLogo from '@/assets/logo.png';
---

<header class="fixed top-0 w-full z-50 bg-green-50 border-b border-border/50 py-4 scroll-animation">
  <div class="flex justify-between items-center px-32">
    <div class="flex items-center gap-2">
      <img src={brandLogo.src} alt="website brand logo" class="w-20 h-18 duration-600 hover:scale-90 transition" />
      <div class="flex flex-col gap-2 leading-tight">
        <span class="text-lg text-emerald-800 tracking-tight">Madera Encantada</span>
        <span class="text-xs uppercase tracking-widest text-green-600">Casas prefabricadas</span>
      </div>
    </div>
    <nav class="flex items-center gap-12 text-md">
      <a href="#about-us" class="hover:text-emerald-600 transition-colors">Sobre nosotros</a>
      <!-- <a href="#information" class="hover:text-emerald-600 transition-colors">Información</a> -->
      <a href="#projects" class="hover:text-emerald-600 transition-colors">Nuestros proyectos</a>
      <a href="#contact" class="text-white px-4 py-2 font-semibold rounded-lg bg-emerald-700 hover:bg-emerald-800 transition-colors">Contacto</a>
    </nav>
  </div>
</header>
