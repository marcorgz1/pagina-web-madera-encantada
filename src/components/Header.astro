---
import brandLogo from '@/assets/brand-logo.png';
---

<header class="fixed top-0 w-full z-50 bg-green-50 border-b border-border/50">
  <div class="flex justify-between items-center px-32">
    <div class="flex items-center gap-2">
      <img src={brandLogo.src} alt="website brand logo" width={260} height={280} />
    </div>
    <nav class="hidden md:flex items-center gap-12 text-md font-body text-muted-foreground">
      <a href="#about-us" class="hover:text-emerald-600 transition-colors">Sobre nosotros</a>
      <!-- <a href="#information" class="hover:text-emerald-600 transition-colors">Información</a> -->
      <a href="#store" class="hover:text-emerald-600 transition-colors">Nuestras casas</a>
      <a href="#contact" class="hover:text-emerald-600 transition-colors">Contacto</a>
    </nav>
  </div>
</header>
