---
import brandLogo from '@/assets/brand-logo.png';
---

<header class="fixed top-0 w-full z-50 bg-yellow-100/80 backdrop-blur-md border-b border-border/50">
        <div class="container mx-auto px-6 flex justify-between items-center">
          <div class="flex items-center gap-2">
            <img src={brandLogo.src} alt="website brand logo" width={220} height={240} />
          </div>
          <nav class="hidden md:flex items-center gap-8 text-sm font-body text-muted-foreground">
            <a href="#about-us" class="hover:text-foreground transition-colors">Sobre nosotros</a>
            <a href="#information" class="hover:text-foreground transition-colors">Información</a>
            <a href="#store" class="hover:text-foreground transition-colors">Nuestras casas</a>
            <a href="#contact" class="hover:text-foreground transition-colors">Contacto</a>
          </nav>
        </div>
      </header>
