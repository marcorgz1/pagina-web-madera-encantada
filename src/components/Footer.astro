---
import brandLogo from '@/assets/logo.png';
import { Image } from 'astro:assets';
import { Facebook, Instagram, Twitter } from 'lucide-astro';
---

<footer class="flex flex-col justify-between items-center bg-gray-900 text-white font-sans py-8 sm:py-12">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-16 lg:gap-12 w-full sm:px-12 lg:px-24 xl:px-32">
            <!-- Company Info Section -->
            <div class="flex flex-col gap-6 text-center md:text-left">
                <div>
                    <Image 
                        src={brandLogo} 
                        alt="brand logo" 
                        class="w-32 h-28 sm:w-42 sm:h-36 mx-auto md:mx-0"
                    >
                </div>
                <p class="text-gray-400 max-w-md leading-relaxed text-sm sm:text-base mx-auto md:mx-0">
                    Somos una empresa fundada con el objetivo de transformar
                    el concepto tradicional de vivienda, como respuesta a la
                    creciente demanda de soluciones habitacionales más
                    eficientes, sostenibles y accesibles. Apostamos por el
                    desarrollo de casas prefabricadas que combinan diseño
                    contemporáneo, innovación tecnológica y altos estándares
                    de calidad.
                </p>
                <div class="flex space-x-4 justify-center md:justify-start">
                    <a href="#" class="text-gray-400 hover:text-emerald-500 transition-colors">
                    <Facebook class="h-6 w-6" />
                    </a>
                    <a href="#" class="text-gray-400 hover:text-emerald-500 transition-colors">
                    <Twitter class="h-6 w-6" />
                    </a>
                    <a href="#" class="text-gray-400 hover:text-emerald-500 transition-colors">
                    <Instagram class="h-6 w-6" />
                    </a>
                </div>
            </div>

            <!-- Quick Links Section -->
            <div class="flex flex-col text-center md:text-left">
                <h3 class="text-lg font-bold mb-4">Accesos rápidos</h3>
                <ul class="space-y-2">
                    <li>
                        <a href="#" class="text-gray-400 hover:text-emerald-500 transition-colors">
                            Sobre nosotros
                        </a>
                    </li>
                    <li>
                        <a href="#homes" class="text-gray-400 hover:text-emerald-500 transition-colors">
                            Nuestras casas
                        </a>
                    </li>
                    <li>
                        <a href="#contact" class="text-gray-400 hover:text-emerald-500 transition-colors">
                            Contáctanos
                        </a>
                    </li>
                    <li>
                        <a href="#" class="text-gray-400 hover:text-emerald-500 transition-colors">
                            FAQ
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Contact Section -->
            <div class="flex flex-col gap-2 text-center md:text-left">
                <h3 class="text-lg font-bold mb-4">Contacto</h3>
                <ul class="space-y-6 text-gray-400">
                    <li class="flex items-center gap-4 justify-center md:justify-start">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="icon icon-tabler icons-tabler-outline icon-tabler-mail"
                                ><path
                                    stroke="none"
                                    d="M0 0h24v24H0z"
                                    fill="none"></path><path
                                    d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10"
                                ></path><path d="M3 7l9 6l9 -6"></path></svg
                            >
                            <a
                                href="mailto:info@maderaencantada.com"
                                class="hover:text-emerald-500 transition-colors"
                                >info@maderaencantada.com</a
                            >
                        </li>
                        <li class="flex justify-center md:justify-start items-center gap-4">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="icon icon-tabler icons-tabler-outline icon-tabler-phone"
                                ><path
                                    stroke="none"
                                    d="M0 0h24v24H0z"
                                    fill="none"></path><path
                                    d="M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2"
                                ></path>
                            </svg>
                            <div class="flex flex-col gap-2">
                                <a
                                    href="tel:+34652447192"
                                    class="hover:text-emerald-500 transition-colors"
                                    >+34 652 447 192</a
                                >
                                <a
                                    href="tel:+34613336085"
                                    class="hover:text-emerald-500 transition-colors"
                                    >+34 613 336 085</a
                                >
                            </div>
                        </li>
                </ul>
            </div>
        </div>

        <div class="border-t border-gray-800 text-center text-gray-400 w-full mt-8 mx-6 sm:mx-12 lg:mx-24 xl:mx-32">            
            <p class="py-6 sm:py-12 text-sm sm:text-base">&copy; 2026 Madera Encantada. Todos los derechos reservados.</p>
        </div>
</footer>

