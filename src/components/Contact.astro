<section>
    <h1 class="text-6xl font-bold text-center mb-8">
        ¿Tienes alguna duda? 
        <br />
        <span class="text-4xl">
            No dudes en contactarnos
        </span>
    </h1>
    <form class="flex flex-col gap-4 mx-auto max-w-4xl">
        <label for="name">Nombre <span class="text-red-400">*</span></label>
        <input class="w-full border border-gray-300 outline-none 
            focus:border-transparent focus:ring-2 focus:ring-amber-200 rounded transition-colors" 
            required 
        />
        <label for="email">Correo <span class="text-red-400">*</span></label>
        <input class="w-full mb-8 border border-gray-300 outline-none 
        focus:border-transparent focus:ring-2 focus:ring-amber-200 rounded transition-colors"
        required
        />
        <label for="message">Mensaje <span class="text-red-400">*</span></label>
        <textarea
            rows="6"
            class="w-full px-4 py-2 border border-gray-300 outline-none 
                focus:border-transparent focus:ring-2 focus:ring-amber-200 rounded mb-8 transition-colors"
            placeholder="Cuñentanos lo que necesites saber" 
        />
        <button class="text-white bg-green-600 px-4 py-2 rounded mx-auto w-fit hover:bg-green-700 transition-colors">
            Enviar
        </button>
    </form>
</section>
