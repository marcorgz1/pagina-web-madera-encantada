<section>
    <h1 class="text-6xl font-bold text-center mb-8">
        ¿Tienes alguna duda? 
        <br />
        <span class="text-4xl">
            No dudes en contactarnos
        </span>
    </h1>
    <form class="flex flex-col gap-4 mx-auto max-w-2xl mb-20">
        <div class="flex items-center gap-12">
            <div class="flex flex-col gap-4">
                <label class="flex items-center gap-2" for="name">Nombre <span class="text-red-400">*</span></label>
                <input class="w-full border border-gray-300 outline-none p-2
                    focus:border-transparent focus:ring-2 focus:ring-amber-700 rounded transition-colors"
                    placeholder="Tu nombre"
                    required 
                />
            </div>
            <div class="flex flex-col gap-4">
                <label class="flex items-center gap-2" for="last-name">Apellidos <span class="text-red-400">*</span></label>
                <input class="w-full border border-gray-300 outline-none p-2
                    focus:border-transparent focus:ring-2 focus:ring-amber-700 rounded transition-colors"
                    placeholder="Tu apellido"
                    required 
                />
            </div>
        </div>
        <label for="email">Correo <span class="text-red-400">*</span></label>
        <input class="w-full mb-8 border border-gray-300 outline-none p-2
        focus:border-transparent focus:ring-2 focus:ring-ring-amber-700 rounded transition-colors"
        placeholder="Tu correo electrónico"
        required
        />
        <label for="message">Mensaje <span class="text-red-400">*</span></label>
        <textarea
            rows="6"
            class="w-full px-4 py-2 border border-gray-300 outline-none 
                focus:border-transparent focus:ring-2 focus:ring-ring-amber-700 rounded mb-8 transition-colors"
            placeholder="Cuéntanos lo que necesites saber"
        />
        <button class="text-white bg-green-600 px-4 py-2 rounded mx-auto w-fit hover:bg-green-700 transition-colors">
            Enviar
        </button>
    </form>
</section>
