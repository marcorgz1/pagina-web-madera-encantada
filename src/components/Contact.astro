---
import { Phone, Mail, MapPin } from "lucide-astro";
---

<section id="contact" class="scroll-mt-32">
    <div class="flex justify-between items-start w-full px-48 mb-24">
        <div class="flex flex-col gap-16">
            <div class="flex flex-col justify-center items-center gap-6 mb-4">
                <h1 class="text-6xl font-bold text-center">
                    Vamos a planificar tu nueva casa
                    <br />
                </h1>
                <span class="text-xl text-amber-800/40">
                    ¿Tienes alguna duda? Nuestro equipo estará encantado de ayudarte a escoger tu casa perfecta.
                </span>
            </div>
            <div class="flex flex-col gap-2">
                <ul class="space-y-6">
                    <li class="flex items-center gap-8">
                        <Mail class="w-6 h-6 text-emerald-700" />
                        <div class="flex flex-col">
                            <p class="text-gray-400">Email</p>
                            <a
                                href="mailto:info@maderaencantada.com"
                                class="hover:text-emerald-500 transition-colors"
                                >info@maderaencantada.com</a
                            >
                        </div>                        
                    </li>
                    <li class="flex items-center gap-8">
                        <Phone class="w-6 h-6 text-emerald-700" />
                        <div class="flex flex-col gap-2 w-full">
                            <p class="text-gray-400">Teléfono</p>
                            <div class="flex gap-6">
                                <a
                                    href="tel:+34652447192"
                                    class="hover:text-emerald-500 transition-colors"
                                >
                                    +34 652 447 192
                                </a>
                                <span>/</span>
                                <a
                                    href="tel:+34613336085"
                                    class="hover:text-emerald-500 transition-colors"
                                >
                                    +34 613 336 085
                                </a>
                            </div>
                        </div>
                    </li>
                    <li class="flex gap-4">
                        <div class="flex gap-8">
                            <MapPin class="w-6 h-6 text-emerald-700" />
                            <div class="flex flex-col gap-2">
                                <p class="text-gray-400">Dirección</p>
                                <p></p>
                            </div>
                        </div>
                    </li>

                </ul>
            </div>
        </div>
        <form class="flex flex-col gap-8 bg-white px-16 py-12 rounded-lg mb-20">
            <div class="flex justify-between gap-12">
                <div class="flex flex-col gap-4">
                    <label class="flex items-center gap-2" for="name">Nombre completo<span class="text-red-400">*</span></label>
                    <input class="w-full border border-gray-300 outline-none px-4 py-2
                        focus:border-transparent focus:ring-2 focus:ring-emerald-500 rounded-lg transition-colors"
                        placeholder="Tu nombre"
                        required 
                    />
                </div>
                <div class="flex flex-col gap-4">
                    <label class="flex items-center gap-2" for="name">Teléfono</label>
                    <input class="w-full border border-gray-300 outline-none px-4 py-2
                        focus:border-transparent focus:ring-2 focus:ring-emerald-500 rounded-lg transition-colors"
                        placeholder="Tu número de teléfono"
                        required 
                    />
                </div>
            </div>
            <div class="flex flex-col gap-4">
                <label for="email">Correo <span class="text-red-400">*</span></label>
                <input class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-transparent outline-none transition-colors"
                placeholder="Tu correo electrónico"
                required
                />
            </div>
            <div class="flex flex-col gap-4">
                <label for="message">Mensaje <span class="text-red-400">*</span></label>
                <textarea
                    rows="6"
                    class="w-full px-4 py-2 border border-gray-300 outline-none 
                        focus:border-transparent focus:ring-2 focus:ring-emerald-500 rounded-lg mb-2 transition-colors"
                    placeholder="Cuéntanos lo que necesites saber"
                />
            </div>
            <button class="text-white font-semibold bg-emerald-600 px-4 py-2 rounded-md mx-auto cursor-pointer w-fit hover:bg-emerald-700 transition-colors">
                Enviar
            </button>
        </form>
    </div>
</section>
