---
import { Mail, MapPin, PhoneCallIcon } from '@lucide/astro';
import OnScrollReveal from 'astro-onscroll-animations';
---

<section id="contact" class="scroll-mt-24 md:scroll-mt-32 sm:scroll-mt-16 px-4 sm:px-6 lg:px-8 scroll-animation scroll-animation-default">
    <div class="flex justify-center items-center mb-24 sm:mb-32 lg:mb-48">
        <div class="flex flex-col max-w-xl sm:max-w-lg md:max-w-6xl w-full gap-8 sm:gap-12">
            <div class="flex flex-col gap-2 mb-10 sm:mb-14 lg:mb-16">
                <h3
                    class="text-emerald-700 text-xs sm:text-sm font-semibold tracking-[0.2em] uppercase"
                >
                    Contáctanos
                </h3>
                <h1
                    class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-amber-800 mb-8"
                >
                    Vamos a planificar tu nueva casa
                    <br />
                </h1>
                <span class="text-base text-stone-600">
                    ¿Tienes alguna duda? Nuestro equipo estará encantado de
                    ayudarte a escoger tu casa perfecta.
                </span>
            </div>
            <div class="mb-12">
                <ul class="grid grid-cols-2 sm:grid-cols-1 md:grid-cols-2 gap-6">
                    <li class="flex items-center w-full px-6 sm:px-8 py-6 border border-gray-200 shadow-sm rounded-2xl gap-6 sm:gap-8 hover:shadow-md">
                        <div class="w-12 h-12 bg-emerald-50 rounded-lg flex items-center justify-center shrink-0">
                            <Mail class="w-6 h-6 text-emerald-800" />
                        </div>
                        <div class="flex flex-col gap-2 min-w-0">
                            <p class="text-gray-400 uppercase text-sm">Escríbenos</p>
                            <a
                                href="mailto:contact@madera-encantada.es"
                                class="break-all"
                                >contact@madera-encantada.es</a
                            >
                        </div>

                    </li>
                    <li class="flex items-center gap-6 sm:gap-8 w-full px-6 sm:px-8 py-6 border border-gray-200 shadow-sm rounded-2xl hover:shadow-md">
                        <div class="w-12 h-12 bg-emerald-50 rounded-lg flex items-center justify-center shrink-0">
                            <PhoneCallIcon class="w-6 h-6 text-emerald-800" />
                        </div>
                        <div class="flex flex-col gap-2">
                            <p class="text-gray-400 uppercase text-sm">Llámanos</p>
                            <div class="flex flex-col gap-2">
                                <a
                                    href="tel:+34652447192"
                                    class="hover:text-emerald-600 transition-colors"
                                >
                                    +34 652 447 192
                                </a>
                                <a
                                    href="tel:+34613336085"
                                    class="hover:text-emerald-600 transition-colors"
                                >
                                    +34 613 336 085
                                </a>
                            </div>
                        </div>
                    </li>
                    <li class="flex items-center px-6 sm:px-8 py-6 border border-gray-200 shadow-sm w-full rounded-2xl gap-6 col-span-1 sm:col-span-1 md:col-span-2">
                        <div class="w-12 h-12 bg-emerald-50 rounded-lg flex items-center justify-center shrink-0">
                            <MapPin class="w-6 h-6 text-emerald-800" />
                        </div>
                        <div class="flex flex-col gap-2">
                            <p class="text-gray-400 uppercase text-sm">Dirección</p>
                            <p class="flex flex-col gap-1">
                                <span>Tudela - Navarra</span>
                                <span>Polígono Las Labradas 1</span>
                                <span>Calle Estella nave C1</span>
                            </p>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <OnScrollReveal />
</section>
