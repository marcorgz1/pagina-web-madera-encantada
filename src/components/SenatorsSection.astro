---
import { Image } from 'astro:assets'

import image from '@/assets/senators/image.jpeg'
import image2 from '@/assets/senators/image2.jpeg'
import image3 from '@/assets/senators/image3.jpeg'
import image4 from '@/assets/senators/image4.webp'
import image5 from '@/assets/senators/image5.jpeg'
import image6 from '@/assets/senators/image6.jpg'
import SenatorCard from './SenatorCard.astro'

const senators = [
    {
        id: '1',
        name: 'Primer senador',
        image: image,
        price: '9.800€',
    },
    {
        id: '2',
        name: 'Segundo senador',
        image: image2,
        price: '6.500€',
    },
    {
        id: '3',
        name: 'Tercer senador',
        image: image3,
        price: '7.800€',
    },
    {
        id: '4',
        name: 'Cuarto senador',
        image: image4,
        price: '6.900€',
    },
    {
        id: '5',
        name: 'Quinto senador',
        image: image5,
        price: '5.200€',
    },
    {
        id: '6',
        name: 'Sexto senador',
        image: image6,
        price: '7.900€',
    },
]
---

<section id="senators" class="py-24 px-4">
    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div
            class="mb-14 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4"
        >
            <div>
                <span
                    class="text-xs uppercase tracking-[0.2em] text-emerald-600 font-semibold mb-3 block"
                >
                    Galería
                </span>
                <h2
                    class="text-5xl sm:text-6xl font-bold text-amber-800 leading-none tracking-tight"
                >
                    Cenadores
                </h2>
            </div>
            <p
                class="text-stone-500 max-w-xs text-sm leading-relaxed sm:text-right"
            >
                Espacios únicos para disfrutar del exterior con estilo y confort
                todo el año.
            </p>
        </div>

        <!-- Divider -->
        <div class="w-full h-px bg-stone-200 mb-14"></div>

        <!-- Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-12">
            {
                senators.map((senator) => (
                    <SenatorCard
                        name={senator.name}
                        image={senator.image}
                        price={senator.price}
                    />
                ))
            }
        </div>
    </div>
</section>
