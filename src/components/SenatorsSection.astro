---
import { ArrowRight, ArrowDown } from 'lucide-astro'
import OnScrollReveal from 'astro-onscroll-animations'

import image from '@/assets/senators/image.jpeg'
import image2 from '@/assets/senators/image2.jpeg'
import image3 from '@/assets/senators/image3.jpeg'
import image4 from '@/assets/senators/image4.webp'
import image5 from '@/assets/senators/image5.jpeg'
import image6 from '@/assets/senators/image6.jpg'
import SenatorCard from './SenatorCard.astro'

const senators = [
    {
        id: '1',
        name: 'Primer senador',
        image: image,
        price: '9.800 €',
    },
    {
        id: '2',
        name: 'Segundo senador',
        image: image2,
        price: '6.500 €',
    },
    {
        id: '3',
        name: 'Tercer senador',
        image: image3,
        price: '7.800 €',
    },
    {
        id: '4',
        name: 'Cuarto senador',
        image: image4,
        price: '6.900 €',
    },
    {
        id: '5',
        name: 'Quinto senador',
        image: image5,
        price: '5.200 €',
    },
    {
        id: '6',
        name: 'Sexto senador',
        image: image6,
        price: '7.900 €',
    },
]
---

<section id="senators" class="py-24 px-4 scroll-animation scroll-animation-default">
    <div class="max-w-6xl mx-auto">
        <!-- Header -->
        <div
            class="mb-14 flex flex-col gap-4"
        >
            <div class="mb-2">
                <span
                    class="text-xs uppercase tracking-[0.2em] text-stone-400 font-semibold mb-3 block"
                >
                    Colección
                </span>
                <h2
                    class="text-5xl sm:text-6xl font-serif text-amber-800 leading-none tracking-tight"
                >
                    Cenadores
                </h2>
            </div>
            <div class="flex justify-between items-center">
                <p
                    class="text-stone-500 max-w-xs text-sm leading-relaxed"
                >
                    <span>✦</span>
                    Espacios únicos para disfrutar del exterior con estilo y confort
                    todo el año.
                </p>
                {senators.length > 3 && (
                    <div class="flex justify-center">
                        <button
                            id="view-all-btn"
                            class="flex items-center text-sm text-emerald-800 font-medium transition-all cursor-pointer"
                        >
                            <span id="view-all-label">Ver todo</span>                            
                            <ArrowDown id="view-all-icon" className="ml-2 h-4 w-4" />
                        </button>
                    </div>
                )}
            </div>
        </div>

        <!-- Divider -->
        <div class="w-full h-px bg-stone-200 mb-14"></div>

        <!-- Grid -->
        <div id="cenators-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-12 mb-16">
            {
                senators.map((senator, index) => (
                    <div class="cenator-card" data-index={index} class:list={[index >= 3 && "hidden"]}>
                        <SenatorCard
                            name={senator.name}
                            image={senator.image}
                            price={senator.price}
                        />
                    </div>
                ))
            }
        </div>
        <div class="flex justify-center items-center mx-auto">
            <a 
                href="#contact" 
                class="flex justify-center items-center border border-gray-300 px-4 py-2 rounded-lg hover:bg-emerald-800 hover:text-white transition-colors"
            >
                Solicitar información 
                <ArrowRight className="ml-2 h-4 w-4" />
            </a>
        </div>
    </div>

    <OnScrollReveal />
</section>

<script>
    const btn = document.getElementById('view-all-btn');
    const label = document.getElementById('view-all-label');
    const icon = document.getElementById('view-all-icon');
    let expanded = false;

    btn?.addEventListener('click', () => {
        expanded = !expanded;
        const allCards = document.querySelectorAll('.cenator-card');

        if (expanded) {
                allCards.forEach(card => card.classList.remove('hidden'));
                if (label) label.textContent = 'Mostrar menos';
                if (icon) icon.style.transform = 'rotate(-90deg)';
            } else {
                allCards.forEach((card, i) => {
                    if (i >= 3) card.classList.add('hidden');
                });
                if (label) label.textContent = 'View All';
                if (icon) icon.style.transform = 'rotate(0deg)';
            }
        });
</script>
