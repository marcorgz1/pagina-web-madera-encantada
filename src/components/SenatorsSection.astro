---
import { ArrowRight } from 'lucide-astro'
import OnScrollReveal from 'astro-onscroll-animations'

import image from '@/assets/senators/image.jpeg'
import image2 from '@/assets/senators/image2.jpeg'
import image3 from '@/assets/senators/image3.jpeg'
import image4 from '@/assets/senators/image4.webp'
import image5 from '@/assets/senators/image5.jpeg'
import image6 from '@/assets/senators/image6.jpg'

import SenatorCard from './SenatorCard.astro'
import RequestInfo from './RequestInfo.astro'

const senators = [
    {
        id: '1',
        name: 'Primer senador',
        image: image,
        price: '7.350 €',
    },
    {
        id: '2',
        name: 'Segundo senador',
        image: image2,
        price: '4.875 €',
    },
    {
        id: '3',
        name: 'Tercer senador',
        image: image3,
        price: '5.850 €',
    },
    {
        id: '4',
        name: 'Cuarto senador',
        image: image4,
        price: '5.175 €',
    },
    {
        id: '5',
        name: 'Quinto senador',
        image: image5,
        price: '5.200 €',
    },
    {
        id: '6',
        name: 'Sexto senador',
        image: image6,
        price: '5.925 €',
    },
]
---

<section id="senators" class="py-16 sm:py-20 lg:py-24 px-4 sm:px-6 lg:px-8 scroll-animation scroll-animation-default">
    <div class="max-w-6xl mx-auto">
        <!-- Header -->
        <div
            class="mb-10 sm:mb-12 lg:mb-14 flex flex-col gap-4"
        >
            <div class="mb-2">
                <span
                    class="text-xs uppercase tracking-[0.2em] text-stone-400 font-semibold mb-3 block"
                >
                    Colección
                </span>
                <h2
                    class="text-4xl sm:text-5xl lg:text-6xl font-serif text-amber-800 leading-none tracking-tight"
                >
                    Cenadores
                </h2>
            </div>
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4">
                <p
                    class="text-stone-500 max-w-xs text-sm leading-relaxed"
                >
                    <span>✦</span>
                    Espacios únicos para disfrutar del exterior con estilo y confort
                    todo el año.
                </p>
                {senators.length > 3 && (
                    <div class="flex sm:justify-end">
                        <button
                            id="view-all-btn"
                            class="flex items-center text-sm text-emerald-800 font-medium transition-all cursor-pointer"
                        >
                            <span id="view-all-label">Ver todo</span>                            
                            <ArrowRight id="view-all-icon" className="ml-2 h-4 w-4" />
                        </button>
                    </div>
                )}
            </div>
        </div>

        <!-- Divider -->
        <div class="w-full h-px bg-stone-200 mb-10 sm:mb-12 lg:mb-14"></div>

        <!-- Grid -->
        <div id="cenators-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 lg:gap-12 mb-24">
            {
                senators.map((senator, index) => (
                    <div class="cenator-card" data-index={index} class:list={[index >= 4 && "hidden"]}>
                        <SenatorCard
                            name={senator.name}
                            image={senator.image}
                            price={senator.price}
                        />
                    </div>
                ))
            }
        </div>
        <RequestInfo />
    </div>

    <OnScrollReveal />
</section>

<script>
    const btn = document.getElementById('view-all-btn');
    const label = document.getElementById('view-all-label');
    const icon = document.getElementById('view-all-icon');
    // Declarar las cards como "expanded = false" al inicio ya que por defecto
    // no se muestran todas
    let expanded = false;

    btn?.addEventListener('click', () => {
        // Altenar la variable "expanded" entre true y no true para simular 
        // la acción de toggle (si se pone true en lugar de !expanded no permite hacer toggle)
        expanded = !expanded;
        // Obtener todas las cards existentes
        const allCards = document.querySelectorAll('.cenator-card');
        // Si las cards están expandidas 
        if (expanded) {
                // Eliminar la clase "hidden" de cada card
                allCards.forEach(card => card.classList.remove('hidden'));
                // Cambiar el texto del botón de "Mostrar todo" a "Mostrar menos"
                if (label) label.textContent = 'Ver menos';
                // Rotar la flecha de al lado del texto hacia abajo para indicar que
                // se está mostrando todo lo disponible
                if (icon) icon.style.transform = 'rotate(90deg)';
            // Si se ha desactivado el desplegable
            } else {
                // Agregar la clase "hidden" a todas las cards para que se vuelvan
                // a ocultar
                allCards.forEach((card, i) => {
                    if (i >= 4) card.classList.add('hidden');
                });
                // Volver a mostrar el texto "Ver Todo" en el botón
                if (label) label.textContent = 'Ver todo';
                // Volver a mostrar flecha de al lado del texto hacia la derecha
                if (icon) icon.style.transform = 'rotate(0deg)';
            }
        });
</script>
