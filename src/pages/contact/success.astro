---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

import '@/styles/global.css';
---
<Layout>
    <Header />
    <main class="flex min-h-[60vh] flex-col items-center justify-center px-6 py-20 text-center">
        <div class="max-w-xl">
        <h1 class="mb-4 text-4xl font-bold text-green-700">¡Mensaje enviado!</h1>
        <p class="mb-8 text-lg text-gray-700">
            Gracias por contactarnos. Tu mensaje ha sido enviado 
            correctamente, te atenderemos lo antes posible.
        </p>
        <p class="mb-8 text-sm text-gray-600 font-sans">
            Serás redirigido al inicio en <span id="countdown">3</span> segundos...
        </p>
        <a
            href="/"
            class="inline-block rounded-lg bg-green-700 px-6 py-3 text-white font-sans font-semibold transition hover:bg-green-800"
        >
            Volver a la página principal
        </a>
        </div>
    </main>
    <Footer />
</Layout>
<!--
Redireccionar a página principal después de 8 segundos de haber enviado
el mensaje correctamente    
-->
<script>
    let seconds = 8;
    const countdown = document.getElementById('countdown');
    const interval = setInterval(() => {
        seconds--;
        // Si el usuario se encuentra en la página del contador, añadir los 
        // 8 segundos al elemento HTML del mismo
        if (countdown) countdown.textContent = String(seconds);
        // Cuando el contador llegue a 0 segundos, limpiarlo y redireccionar al usuario
        // a la página principal
        if (seconds <= 0) {
            clearInterval(interval);
            window.location.href = '/';
        }
    }, 1000);
</script>
